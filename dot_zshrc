# CachyOS defaults first: system oh-my-zsh, powerlevel10k, fzf, autosuggestions,
# syntax-highlighting, history-substring-search, pacman aliases.
# Guarded: on a machine without the distro config this is a no-op, not an error.
[[ -r /usr/share/cachyos-zsh-config/cachyos-config.zsh ]] && source /usr/share/cachyos-zsh-config/cachyos-config.zsh

# --- PATH: tools not managed by mise (pi, hermes, opencode) ---
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"

# --- mise: node/bun/gh/pnpm; shims are prepended, so mise-managed tools
# beat ~/.local/bin. Needs to run after the distro config, which sets its own PATH.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# --- tailscale hostname allowlist (hermes/opencode) ---
export ALLOWED_TAILSCALE_HOSTNAMES="$(tailscale status --json 2>/dev/null | jq -r .Self.DNSName | sed "s/\.$//")"

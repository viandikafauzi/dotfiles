# --- Secrets: never sync ---
.pi/agent/auth.json

# --- Per-machine security state ---
.pi/agent/trust.json

# --- Churn / regenerated data ---
.pi/agent/sessions/**
.pi/agent/ayu/**

# --- Reinstallable (packages come back from settings.json) ---
.pi/agent/bin/**
.pi/agent/npm/**

# --- opencode: config + commands only; deps are reinstallable ---
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/bun.lock
.config/opencode/.gitignore

# --- Never sync dependencies ---
**/node_modules/**

# --- Ops scripts (run from the repo, never applied to $HOME) ---
scripts/

# --- ~/.agents/skills: only the hand-written skills live in this repo ---
# Anything else in there is installed by the skills CLI, not tracked here.
.agents/skills/*
!.agents/skills/bro
